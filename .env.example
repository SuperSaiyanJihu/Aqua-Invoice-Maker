# Database and server
DATABASE_URL=
SESSION_SECRET=
APP_URL=https://your-invoice-app.example.com

# Google OAuth sign-in
# Authorized redirect URI in Google Cloud Console must be:
#   $APP_URL/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Permanent platform owner
SUPER_ADMIN_EMAIL=info@goswimexcel.com

# Existing email delivery configuration
RESEND_API_KEY=

NODE_ENV=production
PORT=5000
